# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.enabledanalytics.com

# Where form submissions are POSTed as JSON (Zapier/Make/Slack/CRM webhook)
FORMS_WEBHOOK_URL=
# Optional separate webhook for newsletter signups
NEWSLETTER_WEBHOOK_URL=

# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Agentforce Service Agent via Salesforce Embedded Messaging (all four required)
NEXT_PUBLIC_SF_EMBEDDED_ORG_ID=
NEXT_PUBLIC_SF_EMBEDDED_DEPLOYMENT=
NEXT_PUBLIC_SF_EMBEDDED_SITE_URL=
NEXT_PUBLIC_SF_EMBEDDED_SCRT2_URL=
